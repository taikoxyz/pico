{
  "name": "pico",
  "version": "0.0.0",
  "private": true,
  "description": "Trustless 1-hop state channel network for micro-payments on Taiko L2.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "secrets:scan": "bash scripts/scan-secrets.sh tree",
    "secrets:scan:history": "bash scripts/scan-secrets.sh history",
    "secrets:scan:staged": "bash scripts/scan-secrets.sh staged",
    "changeset": "changeset",
    "release": "turbo run build --filter='!@inferenceroom/pico-contracts' && changeset publish",
    "version-packages": "changeset version",
    "pico": "node apps/cli/dist/index.js",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  }
}
